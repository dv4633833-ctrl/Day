{
  "schemaVersion": 1,
  "id": "addon-template",
  "version": "${version}",
  "name": "Suspicious Grow",
  "description": "Meteor Client addon that detects cactus and sweet berry bush growth.",
  "authors": [
    "seasnail"
  ],
  "contact": {
    "sources": "https://github.com/MeteorDevelopment/meteor-addon-template"
  },
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.example.addon.AddonTemplate"
    ]
  },
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=21",
    "minecraft": "${mc_version}",
    "meteor-client": "*"
  }
}


